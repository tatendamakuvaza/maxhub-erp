# Copy this file to ".env" and fill in your own PostgreSQL details.
# The .env file is ignored by Git so your password never goes to GitHub.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maxhub_erp
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# --- Online hosting (optional) ---------------------------------------------------------
# Instead of the five DB_ lines you can give ONE connection string (e.g. from Neon).
# On Streamlit Community Cloud put this line in the app's Secrets box, NOT in GitHub.
# DATABASE_URL=postgresql://neondb_owner:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
